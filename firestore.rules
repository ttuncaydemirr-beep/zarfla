rules_version = '2';

// Zarfla — Firestore güvenlik kuralları (proje: zarfla-37da9)
// Veri sözleşmesi: lib/cloud/invite_contract.dart · Test planı: README "Kural test planı".
//
// Davetli sayfası belgeyi ANAHTARSIZ okur (Firestore REST, GET .../documents/invites/{id}):
// tek belge okuma (get) herkese açık (süre dolana kadar), listeleme (list) kapalı.
//
// Kurallar JSON ayrıştıramadığı için `data` (davetli sayfasının okuduğu JSON metni) kilit alanlarına
// düzenli ifadelerle bağlanır: JSON {"id":<belge kimliği>,"type":<type>,"theme":<theme>, ile başlamalı;
// id/type/theme/plan/status/n1/n2/date anahtarları birer kez geçmeli ve üst düzey alanlarla aynı olmalı;
// harf/rakam/tırnak için \u00XX kaçışı yasak (anahtar gizleme hilesine karşı).
// Hediye IBAN'ı ("gift":{"iban":…}) yalnız plan "paid" iken yazılabilir (ücretsizde "iban": anahtarı reddedilir).
// Arka plan müziği ("music":"<parça kimliği>") de yalnız plan "paid" iken yazılabilir; kimlik [a-z0-9-]{1,40}.

service cloud.firestore {
  match /databases/{database}/documents {

    match /invites/{id} {

      // ---------- yardımcılar ----------
      function signedIn() {
        return request.auth != null;
      }

      function validId() {
        return id.matches('[A-Za-z0-9]{12}');
      }

      function keysOk(d) {
        return d.keys().hasOnly(['ownerUid', 'schema', 'data', 'plan', 'status', 'createdAt',
                                 'expiresAt', 'deleteAt', 'type', 'theme', 'n1', 'n2', 'date',
                                 'origDate', 'nameEdits', 'dateEdits'])
            && d.keys().hasAll(['ownerUid', 'schema', 'data', 'plan', 'status', 'createdAt',
                                'expiresAt', 'deleteAt', 'type', 'theme', 'n1', 'n2', 'date',
                                'origDate', 'nameEdits', 'dateEdits']);
      }

      function tokenOk(s) {
        return s is string && s.matches('[a-z0-9]{1,24}');
      }

      function isoDate(s) {
        return s is string && s.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
      }

      // İsimler: çift tırnak, ters bölü ve kontrol karakteri yok (JSON'da kaçışsız yazılsın diye).
      function safeName(s) {
        return s is string && s.size() <= 120 && s.matches('[^"\\\\\\x00-\\x1f]*');
      }

      // JSON'da "key": en fazla bir kez geçer (ikinci kopya ile ezme hilesine karşı).
      function once(d, key) {
        return !d.data.matches('(?s).*"' + key + '"\\s*:.*"' + key + '"\\s*:.*');
      }

      function dataOk(d) {
        return d.data is string
            && d.data.size() < 200000
            && d.data.matches('(?s)\\{"id":"' + id + '","type":"' + d.type + '","theme":"' + d.theme + '",.*\\}')
            && once(d, 'id') && once(d, 'type') && once(d, 'theme') && once(d, 'plan')
            && once(d, 'status') && once(d, 'n1') && once(d, 'n2') && once(d, 'date')
            && !d.data.matches('(?s).*\\\\u00[2-7][0-9a-fA-F].*')
            && d.data.matches('(?s).*"n1":"\\Q' + d.n1 + '\\E".*')
            && d.data.matches('(?s).*"n2":"\\Q' + d.n2 + '\\E".*')
            && d.data.matches('(?s).*"date":"' + d.date + '".*')
            && d.data.matches('(?s).*"status":"live".*')
            && d.data.matches('(?s).*"plan":"' + (d.plan == 'paid' ? 'premium' : 'free') + '".*')
            // Hediye IBAN'ı YALNIZ ücretli planda: ücretsiz belgenin data JSON'unda "iban": anahtarı olamaz.
            // (Anahtar \u0069 gibi kaçışla gizlenemez: yukarıda \u00XX harf kaçışı yasak. Kullanıcı metnindeki
            // tırnaklar JSON'da \" olarak kaçışlı olduğundan metin içinden sahte "iban": üretilemez.)
            && (d.plan == 'paid' || !d.data.matches('(?s).*"iban"\\s*:.*'))
            // Arka plan müziği YALNIZ ücretli planda (aynı gerekçe: anahtar kaçışla gizlenemez, metinden sahtesi üretilemez).
            // Ücretli planda değer yalnız seçki kimliği biçiminde olabilir (dosya yolu/adres değil).
            && once(d, 'music')
            && (d.plan == 'paid' || !d.data.matches('(?s).*"music"\\s*:.*'))
            && (!d.data.matches('(?s).*"music"\\s*:.*') || d.data.matches('(?s).*"music":"[a-z0-9-]{1,40}"[,}].*'));
      }

      // Her yazmada (create + update) geçerli alan denetimi.
      function fieldsOk(d) {
        return keysOk(d)
            && d.ownerUid is string
            && d.schema == 1
            && d.plan in ['free', 'paid']
            && d.status == 'live'
            && d.expiresAt is timestamp
            && d.deleteAt is timestamp
            && d.deleteAt >= d.expiresAt
            && d.deleteAt <= d.expiresAt + duration.value(31, 'd')
            && tokenOk(d.type) && tokenOk(d.theme)
            && safeName(d.n1) && safeName(d.n2)
            && isoDate(d.date) && isoDate(d.origDate)
            && d.nameEdits is int && d.nameEdits >= 0 && d.nameEdits <= 3
            && d.dateEdits is int && d.dateEdits >= 0 && d.dateEdits <= 2
            // Ücretsiz plan yalnız Papatya tasarımıyla
            && (d.plan == 'paid' || d.theme == 'papatya')
            && dataOk(d);
      }

      function unchanged(keys) {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
      }

      function toTs(s) {
        let p = s.split('-');
        return timestamp.date(int(p[0]), int(p[1]), int(p[2]));
      }

      // |date - origDate| <= 60 gün (tarih dizeleri UTC gece yarısı zaman damgasına çevrilir)
      function withinWindow(d) {
        return duration.abs(toTs(d.date) - toTs(d.origDate)) <= duration.value(60, 'd');
      }

      function freeUpdateOk() {
        let n = request.resource.data;
        let o = resource.data;
        return n.nameEdits == o.nameEdits && n.dateEdits == o.dateEdits;
      }

      function paidUpdateOk() {
        let n = request.resource.data;
        let o = resource.data;
        let namesChanged = n.n1 != o.n1 || n.n2 != o.n2;
        let dateChanged = n.date != o.date;
        return n.type == o.type
            && n.theme == o.theme
            && (namesChanged
                  ? (n.nameEdits == o.nameEdits + 1 && n.nameEdits <= 3)
                  : n.nameEdits == o.nameEdits)
            && (dateChanged
                  ? (n.dateEdits == o.dateEdits + 1 && n.dateEdits <= 2 && withinWindow(n))
                  : n.dateEdits == o.dateEdits);
      }

      // ---------- okuma ----------
      // Var olmayan belge: yalnız "yok" bilgisi döner (404) — yayında kimlik çakışma denetimi için de gerekli.
      // Sahibi kendi belgesini süre dolduktan sonra da okuyabilir (güncelle/sil işlemleri için).
      allow get: if resource == null
                 || request.time < resource.data.expiresAt
                 || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow list: if false;

      // ---------- oluşturma: istemciden YALNIZ ücretsiz ----------
      // Ücretli (plan "paid") belgeyi yalnız redeemPurchase fonksiyonu yazar (Admin SDK kuralları atlar,
      // Google Play satın alma jetonunu doğruladıktan sonra). İstemci "paid" oluşturamaz ve "free"den
      // "paid"e yükseltemez (güncellemede plan değişmez). Ücretsiz süre: en çok 24 saat + 10 dk saat farkı payı.
      // "Aynı anda 1 ücretsiz" sınırı: enforceFreeLimit fonksiyonu (kurallar diğer belgeleri sayamaz).
      allow create: if signedIn()
                    && validId()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.plan == 'free'
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.expiresAt > request.time
                    && request.resource.data.expiresAt <= request.time + duration.value(1450, 'm')
                    && request.resource.data.nameEdits == 0
                    && request.resource.data.dateEdits == 0
                    && request.resource.data.origDate == request.resource.data.date
                    && fieldsOk(request.resource.data);

      // ---------- güncelleme: yalnız sahibi ----------
      allow update: if signedIn()
                    && resource.data.ownerUid == request.auth.uid
                    && unchanged(['ownerUid', 'createdAt', 'plan', 'origDate', 'schema'])
                    // süre istemciden uzatılamaz (yeniden açma Aşama 3'te sunucuda)
                    && request.resource.data.expiresAt <= resource.data.expiresAt
                    && request.resource.data.deleteAt <= resource.data.deleteAt
                    && fieldsOk(request.resource.data)
                    && (resource.data.plan == 'free' ? freeUpdateOk() : paidUpdateOk());

      // ---------- silme: yalnız sahibi ----------
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // users/{uid}: premium (reklamsız) bayrağı. Yalnız redeemPurchase / voidedPurchases yazar;
    // kullanıcı yalnız kendi belgesini okur.
    match /users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    // credits/{uid}: "Düğün Zinciri" paketinin hak defteri (balance, lots, ledger). Yalnız redeemPurchase /
    // useCredit / voidedPurchases yazar; kullanıcı yalnız kendi bakiyesini okur ("2 hakkınız kaldı").
    match /credits/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    // purchases/{sha256(jeton)}: satın alma kayıtları — yalnız sunucu (istemciye tamamen kapalı).
    match /purchases/{hash} {
      allow read, write: if false;
    }

    // Diğer her şey kapalı
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
