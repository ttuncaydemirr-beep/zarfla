{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "hosting",
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "cleanUrls": false,
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300, must-revalidate"
          }
        ]
      },
      {
        "source": "/davetiye",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow, noarchive"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=300, must-revalidate"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'none'; script-src 'sha256-cg3v1xkYzKaDGuBjlYoXN9pRehmaICf3OFoTvB2NEgc='; style-src 'unsafe-inline'; img-src 'self' data: https://firebasestorage.googleapis.com; font-src 'self'; media-src 'self'; connect-src https://firestore.googleapis.com; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'"
          }
        ]
      },
      {
        "source": "/davetiye/",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow, noarchive"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=300, must-revalidate"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'none'; script-src 'sha256-cg3v1xkYzKaDGuBjlYoXN9pRehmaICf3OFoTvB2NEgc='; style-src 'unsafe-inline'; img-src 'self' data: https://firebasestorage.googleapis.com; font-src 'self'; media-src 'self'; connect-src https://firestore.googleapis.com; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'"
          }
        ]
      },
      {
        "source": "/davetiye/**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow, noarchive"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=300, must-revalidate"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'none'; script-src 'sha256-cg3v1xkYzKaDGuBjlYoXN9pRehmaICf3OFoTvB2NEgc='; style-src 'unsafe-inline'; img-src 'self' data: https://firebasestorage.googleapis.com; font-src 'self'; media-src 'self'; connect-src https://firestore.googleapis.com; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'"
          }
        ]
      },
      {
        "source": "/music/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      },
      {
        "source": "/fonts/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": ["node_modules", "test", ".git", "*.log", "package-lock.json"]
    }
  ],
  "emulators": {
    "firestore": { "host": "127.0.0.1", "port": 8080 },
    "storage": { "host": "127.0.0.1", "port": 9199 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
